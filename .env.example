# XMPP interoperability validation — synthetic/test account only.
ATOMIC_XMPP_SERVICE=xmpp.example.test
ATOMIC_XMPP_DOMAIN=example.test
ATOMIC_XMPP_PORT=5222
# Explicit transport: starttls (normally 5222) or direct-tls (normally 5223).
ATOMIC_XMPP_TRANSPORT=starttls
# Legacy compatibility only; ignored when ATOMIC_XMPP_TRANSPORT is set.
ATOMIC_XMPP_TLS=false
ATOMIC_XMPP_USERNAME=test-user
ATOMIC_XMPP_PASSWORD=replace-with-synthetic-password
ATOMIC_XMPP_ALLOW_INSECURE_TLS=false
# Optional Main-only game admission/rate limits. Defaults are documented in
# docs/reference/environment-variables.md; keep values bounded and positive.
# ATOMIC_GAMES_MAX_SESSIONS_PER_ACCOUNT=32
# ATOMIC_GAMES_MAX_SESSIONS_PER_PEER=8
# ATOMIC_GAMES_MAX_PENDING_SESSIONS_PER_ACCOUNT=16
# ATOMIC_GAMES_MAX_EVENTS_PER_WINDOW=128
# ATOMIC_GAMES_EVENT_WINDOW_MS=1000
# ATOMIC_GAMES_MAX_PENDING_ACKS_PER_SESSION=32
# ATOMIC_GAMES_MAX_STATE_REQUESTS_PER_SESSION=4
# ATOMIC_GAMES_MAX_SEEN_EVENTS_PER_SESSION=4096
# ATOMIC_GAMES_MAX_RATE_SCOPES_PER_ACCOUNT=128
# Test-only packaged smoke controls; leave unset for normal development/product use.
# ATOMIC_CHAT_PACKAGED_SMOKE=1
# ATOMIC_CHAT_SMOKE_DATA_ROOT=C:\\path\\to\\temporary-smoke-root
# Optional operator-managed MUC allowlist. If omitted, the XMPP server decides
# who can join an already discovered room; Atomic Chat still blocks room creation.
# If one or more policies are configured, all joins require a matching entry
# bound to the exact account, MUC service and XMPP endpoint.
# The endpoint field is mandatory; obtain the evidence from an authorized operator.
# ATOMIC_XMPP_MUC_POLICY_JSON=[{"accountId":"test-user@example.test","service":"conference.example.test","canCreate":false,"source":"operator","evidence":"lab-admin-record","endpoint":{"host":"xmpp.example.test","port":5222,"transport":"starttls"}}]
