# XMPP interoperability validation — synthetic/test account only.
ATOMIC_XMPP_SERVICE=xmpp.example.test
ATOMIC_XMPP_DOMAIN=example.test
ATOMIC_XMPP_PORT=5222
# Explicit transport: starttls (normally 5222) or direct-tls (normally 5223).
ATOMIC_XMPP_TRANSPORT=starttls
# Legacy compatibility only; ignored when ATOMIC_XMPP_TRANSPORT is set.
ATOMIC_XMPP_TLS=false
ATOMIC_XMPP_USERNAME=test-user
ATOMIC_XMPP_PASSWORD=replace-with-synthetic-password
ATOMIC_XMPP_ALLOW_INSECURE_TLS=false
# Operator declaration only; bind each MUC policy to the exact XMPP endpoint.
# The endpoint field is mandatory; obtain the evidence from an authorized operator.
# ATOMIC_XMPP_MUC_POLICY_JSON=[{"accountId":"test-user@example.test","service":"conference.example.test","canCreate":false,"source":"operator","evidence":"lab-admin-record","endpoint":{"host":"xmpp.example.test","port":5222,"transport":"starttls"}}]
