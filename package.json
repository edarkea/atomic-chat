{
  "name": "atomic-chat",
  "version": "0.0.6",
  "description": "A retro-futuristic desktop XMPP messaging client built with Angular, TypeScript and Electron.",
  "author": {
    "name": "Edinson Ayui",
    "url": "https://github.com/edarkea"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edarkea/atomic-chat.git"
  },
  "bugs": {
    "url": "https://github.com/edarkea/atomic-chat/issues"
  },
  "homepage": "https://github.com/edarkea/atomic-chat",
  "keywords": [
    "atomic-chat",
    "xmpp",
    "openfire",
    "messaging",
    "desktop",
    "electron",
    "angular",
    "typescript"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "npm run build",
    "electron": "node --env-file=.env node_modules/electron/cli.js electron/main.cjs",
    "test:node": "node --env-file=.env --test tests/*.test.cjs",
    "test:node:outgoing": "node --env-file=.env --test tests/file-transfer.outgoing.test.cjs",
    "test:node:outgoing:safety": "node --env-file=.env --test --test-name-pattern=\"^Outgoing file transfer robustness:\" tests/file-transfer.outgoing.test.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:angular": "ng test --no-watch --no-progress",
    "test:ci:focused": "ng test --no-watch --no-progress --include src/app/features/conversation/message-composer.spec.ts --include src/app/features/conversation/message-date-time.spec.ts && node --test tests/message-search.test.cjs tests/sticker-message-ipc.test.cjs tests/update-service.test.cjs tests/ci-cd-contract.test.cjs tests/login-credentials.test.cjs",
    "test:electron": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; const child = require('node:child_process').spawnSync(require('electron'), ['tests/electron-ipc.integration.cjs'], { stdio: 'inherit', env: process.env }); process.exit(child.status ?? 1)\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && npm run typecheck:electron",
    "typecheck:electron": "tsc -p tsconfig.electron-checkjs.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "format:check": "prettier --check \"eslint.config.mjs\" \"vitest.config.ts\" \"package.json\" \"angular.json\"",
    "format:check:all": "prettier --check \"src/**/*.{ts,html,scss}\" \"electron/**/*.cjs\" \"tests/**/*.cjs\" \"*.{json,mjs,ts}\"",
    "docs:links": "node scripts/check-markdown-links.cjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@xmpp/client": "^0.14.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "^21.4.0",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.atomicchat.desktop",
    "productName": "Atomic Chat",
    "copyright": "Copyright © 2026 Edinson Ayui",
    "directories": {
      "output": "release"
    },
    "artifactName": "AtomicChat-${version}-${os}-${arch}.${ext}",
    "electronUpdaterCompatibility": ">=6.8",
    "npmRebuild": true,
    "publish": {
      "provider": "github",
      "owner": "edarkea",
      "repo": "atomic-chat",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "dist/atomic-chat/browser/**/*",
      "build/icons/128x128.png"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AtomicChat-${version}-windows-x64.${ext}"
    },
    "linux": {
      "category": "Network",
      "maintainer": "Edinson Ayui <edison.ayui@gmail.com>",
      "icon": "build/icons",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AtomicChat-${version}-linux-x64.${ext}"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true,
    "electron@45.2.2": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.6": true
  }
}
